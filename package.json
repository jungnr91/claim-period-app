{
  "name": "claim-period-reference",
  "version": "0.2.0",
  "private": true,
  "author": "국가채권 교육용 시제품",
  "description": "국가채권 규정 근거 탐색 및 교육용 기간 계산기",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:electron": "electron tests/electron-smoke.cjs",
    "build:win": "node build/build-installer.cjs"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.0",
    "fflate": "^0.8.2"
  },
  "build": {
    "appId": "local.claim.period.reference",
    "productName": "법령나침반 교육용",
    "directories": { "output": "dist" },
    "asar": false,
    "files": ["**/*", "!dist/**", "!tests/**"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "법령나침반 교육용",
      "artifactName": "claim-period-reference-setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
